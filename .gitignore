# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/output

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-dev*.log
.tmp-next*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/uploads/

# local development worktrees
.worktrees/

# unused local AI tooling
/.gemini/

# E2E suite (Playwright, npm run test:e2e): the HTML report, the per-test artifacts (traces, screenshots) and the
# run summary, and the run state (run id, users with their generated passwords, sessions). .env.e2e, the seed
# admin sign-in, is ignored by .env* above.
/e2e-report/
/e2e-results/
/e2e/.state/
